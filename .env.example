# Copiá este archivo a .env y completá con las credenciales de Payway
# (Panel Payway → Modo Sandbox / Producción). NUNCA commitear .env.
# En Vercel: cargar las mismas variables en Project Settings → Environment Variables.

PAYWAY_ENV=sandbox
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
PAYWAY_SITE_ID=
PAYWAY_TEMPLATE_ID=
# Sandbox usa https://developers.decidir.com/api/v2 por defecto.
# En producción es obligatorio: poné el endpoint que muestra el panel de Payway + /api/v2
PAYWAY_API_URL=

# Solo cambia el texto "MODO PRUEBA" del checkout
VITE_PAYWAY_ENV=sandbox

# --- Opcional: aviso de cada venta por mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_EMAIL_TO=

# --- Opcional: aviso de cada venta por WhatsApp (CallMeBot, gratis) ---
# Pasos: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# WHATSAPP_NOTIFY_PHONE con código de país, ej: 5491171217804
WHATSAPP_NOTIFY_PHONE=
CALLMEBOT_APIKEY=

# --- Mercado Pago (Checkout Pro) ---
# mercadopago.com.ar/developers → Tus integraciones → Credenciales
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# URL pública https del sitio (Vercel). Habilita el webhook de MP y el regreso automático.
# En localhost dejar vacío.
PUBLIC_URL=
